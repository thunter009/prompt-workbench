{
  "name": "prompt-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:e2e": "pnpm run db:e2e:prepare && PROMPT_WORKBENCH_DB_PATH=$HOME/.prompt-workbench/e2e/data.db PW_ENABLE_TEST_API=1 next dev --turbopack --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:run": "vitest run",
    "cleanup:test-snippets": "node scripts/cleanup-test-snippets.mjs",
    "db:e2e:prepare": "mkdir -p \"$HOME/.prompt-workbench/e2e\"",
    "db:e2e:reset": "pnpm run db:e2e:prepare && rm -f \"$HOME/.prompt-workbench/e2e/data.db\" \"$HOME/.prompt-workbench/e2e/data.db-shm\" \"$HOME/.prompt-workbench/e2e/data.db-wal\"",
    "db:push": "drizzle-kit push",
    "db:push:e2e": "pnpm run db:e2e:prepare && PROMPT_WORKBENCH_DB_PATH=$HOME/.prompt-workbench/e2e/data.db drizzle-kit push"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/merge": "^6.11.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@types/mdast": "^4.0.4",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.1",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.563.0",
    "next": "^15.5.15",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
